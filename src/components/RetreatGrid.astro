---
/**
 * Card grid with "Mehr laden": all cards are in the HTML (SEO, visible
 * without JS), everything from `initial` on is `hidden`. Each click reveals
 * the next `blog.loadMoreStep` cards (main.ts → initLoadMore).
 */
import RetreatCard from "./RetreatCard.astro";
import { blog } from "../data/settings";
import type { Retreat } from "../utils/retreats";

interface Props {
  retreats: Retreat[];
  /** Number of visible cards before "Mehr laden". */
  initial: number;
}

const { retreats, initial } = Astro.props;
const hasMore = retreats.length > initial;
// Without JavaScript: show all cards, hide the button
const noscriptCss =
  ".load-more .article[hidden]{display:block!important}.load-more__actions{display:none}";
---

<div class="load-more" data-load-more={blog.loadMoreStep}>
  <div class="row grid">
    {
      retreats.map((retreat, i) => (
        <RetreatCard
          retreat={retreat}
          class="grid__post"
          hidden={i >= initial}
        />
      ))
    }
  </div>

  {
    hasMore && (
      <div class="load-more__actions">
        <button type="button" class="button load-more__button">
          {blog.loadMoreLabel}
        </button>
      </div>
    )
  }
</div>

{
  hasMore && (
    <noscript>
      <style is:inline set:html={noscriptCss} />
    </noscript>
  )
}
