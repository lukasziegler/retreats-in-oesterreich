---
/**
 * Karten-Raster mit „Mehr laden“: Alle Karten stehen im HTML (SEO, ohne JS
 * sichtbar), alles ab `initial` ist `hidden`. Der Button blendet pro Klick
 * die nächsten `blog.loadMoreStep` Karten ein (main.ts → initLoadMore).
 */
import RetreatCard from "./RetreatCard.astro";
import { blog } from "../data/settings";
import type { Retreat } from "../utils/retreats";

interface Props {
  retreats: Retreat[];
  /** Anzahl sichtbarer Karten vor „Mehr laden“. */
  initial: number;
}

const { retreats, initial } = Astro.props;
const hasMore = retreats.length > initial;
// Ohne JavaScript: alle Karten zeigen, Button ausblenden
const noscriptCss =
  ".load-more .article[hidden]{display:block!important}.load-more__actions{display:none}";
---

<div class="load-more" data-load-more={blog.loadMoreStep}>
  <div class="row grid">
    {
      retreats.map((retreat, i) => (
        <RetreatCard
          retreat={retreat}
          class="grid__post"
          hidden={i >= initial}
        />
      ))
    }
  </div>

  {
    hasMore && (
      <div class="load-more__actions">
        <button type="button" class="button load-more__button">
          {blog.loadMoreLabel}
        </button>
      </div>
    )
  }
</div>

{
  hasMore && (
    <noscript>
      <style is:inline set:html={noscriptCss} />
    </noscript>
  )
}
